{
  "name": "@leda/web-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Purpose-built client-side WebGPU inference runtime for Leda Demo v0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "serve": "npm run build && node dev/server.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@webgpu/types": "0.1.52",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
